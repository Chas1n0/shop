# Set real values in Netlify Project configuration > Environment variables.
# Never commit secrets. Configure the production context; previews use separate storage.
SITE_URL=https://chasemcdougall.com
MANAGER_EMAIL=
# Generate with npm run password (hash output only).
MANAGER_PASSWORD_HASH=
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Restricted Stripe server key with Checkout Sessions write/read access.
STRIPE_SECRET_KEY=
# Signing secret for /api/shop/webhook; configure all events listed in README.
STRIPE_WEBHOOK_SECRET=
